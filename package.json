{
  "name": "@ragib.mrb/routepeek",
  "version": "0.1.0",
  "description": "See every route in your Express app, with its arguments, and test it from a zero-config page.",
  "license": "MIT",
  "author": "Ragib MRB",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ragib-mrb/routepeek.git"
  },
  "homepage": "https://github.com/ragib-mrb/routepeek#readme",
  "bugs": {
    "url": "https://github.com/ragib-mrb/routepeek/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "express",
    "routes",
    "endpoints",
    "api",
    "explorer",
    "api-testing",
    "developer-tools",
    "swagger-alternative"
  ],
  "scripts": {
    "build:ui": "node scripts/build-ui.mjs",
    "build": "npm run build:ui && tsup",
    "typecheck": "npm run build:ui && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build:ui && vitest run",
    "example": "npm run build && node examples/basic.mjs"
  },
  "peerDependencies": {
    "express": ">=4.17.0 <6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "eslint": "10.13.0",
    "express": "5.3.0",
    "express-validator": "7.3.2",
    "express4": "npm:express@4.22.3",
    "joi": "18.3.1",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
